{
  "manifest_version": 3,
  "name": "Template App",
  "version": "0.0.0",
  "description": "A template blank project.",
  
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Template App",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }

}
